# ---------------------------------------------------------------------------
# Copy to .env and fill in.  `.env` is git-ignored.
# ---------------------------------------------------------------------------

# Required. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-a-real-key

# PostgreSQL connection string. Must use the asyncpg driver.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/whatsapp_clone

# Comma-separated list of origins allowed to call the API from a browser.
# Add your Vite dev-server origin here.
CORS_ORIGINS=http://localhost:5173,http://localhost:19720,http://localhost:3000

# JWT access-token lifetime, in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Where uploaded files land, and the base URL used to build their public URLs.
UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://localhost:8000
MAX_UPLOAD_SIZE_MB=10

# "development" | "production". Controls logging verbosity only.
ENV=development

# Dev/test convenience: create tables from the SQLAlchemy models on startup
# instead of running Alembic. Leave false for anything real.
AUTO_CREATE_TABLES=false
